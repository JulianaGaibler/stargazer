{
  "name": "@julianagaibler/stargazer",
  "version": "0.1.0",
  "type": "module",
  "description": "A rendering engine written in TypeScript.",
  "license": "MPL-2.0",
  "author": "Juliana Gaibler",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JulianaGaibler/stargazer.git"
  },
  "homepage": "https://github.com/JulianaGaibler/stargazer#readme",
  "bugs": {
    "url": "https://github.com/JulianaGaibler/stargazer/issues"
  },
  "keywords": [
    "2d",
    "rendering",
    "webgpu",
    "webgl2",
    "game-engine",
    "scene-graph",
    "svelte",
    "typescript",
    "lottie"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src/ demo/",
    "test": "vitest",
    "test:run": "vitest run",
    "prettier": "prettier --write --check '{src,demo}/**/*.*'",
    "check:wgsl": "node scripts/checkWgsl.mjs",
    "gen:squircle": "node scripts/genSquircleField.mjs",
    "gen:shaders": "cargo build --release -p shader-gen && ./target/release/shader-gen src",
    "docs": "typedoc --options typedoc.json",
    "docs:watch": "typedoc --options typedoc.json --watch",
    "knip": "knip",
    "gen:diagnostics": "node scripts/genDiagnosticsDocs.mjs && prettier --write src/docs/guides/diagnostics.md",
    "check:shaders": "npm run gen:shaders && git diff --exit-code -- 'src/**/*.gen.*' 'src/**/*.reflect.json'",
    "demo": "vite --config demo/vite.config.js",
    "demo:build": "vite build --config demo/vite.config.js"
  },
  "dependencies": {
    "earcut": "^2.2.4",
    "esm-env": "^1.2.2"
  },
  "peerDependencies": {
    "svelte": "^5",
    "@webgpu/types": "^0.1.0"
  },
  "devDependencies": {
    "@clean-jsdoc-theme/typedoc": "^5.0.8",
    "@eslint/js": "^9.39.2",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/earcut": "^3.0.0",
    "@types/node": "^24.13.2",
    "@webgpu/types": "^0.1.71",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^17.0.0",
    "happy-dom": "^20.10.6",
    "knip": "^6.43.0",
    "prettier": "^3.9.4",
    "prettier-plugin-jsdoc": "^1.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "sass": "^1.101.0",
    "svelte": "^5.46.1",
    "svelte-check": "^4.3.5",
    "typedoc": "^0.28.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^7.3.1",
    "vitest": "^4.1.9"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/debug/ui/debug-ui.css.js",
    "./dist/debug/ui/index.js",
    "./dist/debug-ui.js",
    "**/*.svelte"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./debug-ui": {
      "types": "./dist/debug-ui.d.ts",
      "svelte": "./dist/debug-ui.js",
      "default": "./dist/debug-ui.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "svelte": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "svelte": "./dist/index.js",
  "peerDependenciesMeta": {
    "@webgpu/types": {
      "optional": true
    }
  }
}
