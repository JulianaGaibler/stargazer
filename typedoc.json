{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/modules/*.ts"],
  "entryPointStrategy": "resolve",
  "exclude": ["**/*.test.ts", "**/debug/ui/**", "**/webgl2/**", "**/*.svelte"],
  "tsconfig": "tsconfig.json",
  "readme": "README.md",
  "plugin": ["@clean-jsdoc-theme/typedoc"],
  "outputs": [
    {
      "name": "clean-jsdoc-theme",
      "path": "site"
    }
  ],
  "categorizeByGroup": false,
  "sort": ["source-order"],
  "skipErrorChecking": true,
  "highlightLanguages": [
    "bash",
    "console",
    "css",
    "html",
    "javascript",
    "json",
    "jsonc",
    "json5",
    "yaml",
    "tsx",
    "typescript",
    "svelte"
  ],
  "externalSymbolLinkMappings": {
    "typescript": {
      "AbortSignal": "https://developer.mozilla.org/en-US/docs/Web/API/AbortSignal"
    }
  },
  "intentionallyNotExported": [
    "CameraHost",
    "CameraRegistry",
    "World3DReadout",
    "DebugLine3DRenderer",
    "MeshRenderer",
    "TextureInspector",
    "TextureSource",
    "GltfDoc",
    "GfxDevice",
    "Texture",
    "RenderTarget"
  ],
  "cleanJsdocTheme": {
    "siteName": "Stargazer",
    "docs": "src/docs",
    "docGroups": ["Getting started", "Features", "3D", "Internals"],
    "copyPage": true
  },
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "requiredToBeDocumented": [
    "Enum",
    "EnumMember",
    "Variable",
    "Function",
    "Class",
    "Interface",
    "Method",
    "CallSignature",
    "GetSignature",
    "TypeAlias"
  ]
}
